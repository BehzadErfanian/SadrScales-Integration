<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AssemblyName>SadrScales.Integration</AssemblyName>
    <RootNamespace>SadrScales.Integration</RootNamespace>

    <PackageId>SadrScales.Integration</PackageId>
    <Version>1.1.0</Version>
    <Authors>Tozin Sadr; Behzad Erfanian</Authors>
    <Copyright>Copyright © 2026 Tozin Sadr and Behzad Erfanian</Copyright>
    <Title>Sadr Scales Integration SDK</Title>
    <Description>Official C# SDK for the public Sadr Scales SQL Contract v1, provided and maintained by Tozin Sadr and Behzad Erfanian.</Description>
    <PackageProjectUrl>https://github.com/BehzadErfanian/SadrScales-Integration</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BehzadErfanian/SadrScales-Integration.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sadr scales pos erp accounting sql integration</PackageTags>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
